{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["server", "src/types.ts", "src/geometry.ts", "src/protocol.ts", "src/ops.ts", "vite.config.ts"]
}
