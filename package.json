{
  "name": "brainboard",
  "version": "0.3.0",
  "private": true,
  "description": "A minimal, near-infinite whiteboard for notes, images, sketches and flow charts, with real-time collaboration, vim keys and an MCP server for AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-armageddon/brainboard.git"
  },
  "homepage": "https://brainboard.ink",
  "keywords": [
    "whiteboard",
    "flowchart",
    "collaboration",
    "realtime",
    "mcp",
    "vim"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "vite build && node server/main.ts",
    "share": "vite build && node server/main.ts --share",
    "prod": "vite build && BRAINBOARD_PUBLIC_URL=${BRAINBOARD_PUBLIC_URL:-https://brainboard.ink} node server/main.ts",
    "mcp": "node server/mcp.ts"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "clipper-lib": "^6.4.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
