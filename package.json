{
  "name": "brainboard",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal infinite whiteboard: paste images, write notes, draw, and build bubble flow charts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "vite build && node server/main.ts",
    "share": "vite build && node server/main.ts --share",
    "mcp": "node server/mcp.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
